# Branding defaults (public - also editable at runtime from the in-app Export HTML modal)
NEXT_PUBLIC_BRAND_NAME="Saqib Visuals"
NEXT_PUBLIC_DEVELOPER_NAME="Muhammad Saqib"
NEXT_PUBLIC_CHANNEL_URL="https://youtube.com/@saqibvisuals"
NEXT_PUBLIC_AVATAR_URL="https://ik.imagekit.io/mrsaqib/mrsaqib242-img25_7oG52NZUY.png"

# Canonical origin used when building short links for bots/API consumers.
# Leave empty to auto-detect from the incoming request headers.
NEXT_PUBLIC_SITE_URL=""

# Directory used for the lightweight JSON data store (shortlinks, logs, users).
# On read-only/serverless hosts (Vercel) point this at a writable volume, or
# replace the JSON store with a real database (see README).
SUPASHORT_DATA_DIR=".data"

# HMAC key for session tokens. REQUIRED in production: if unset a random key is
# generated at boot, so every restart signs everyone out.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""
