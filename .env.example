# ─────────────────────────────────────────────────────────────
# CIPHER BVG — environment template
# Copy to .env and fill in the real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Telegram bot ─────────────────────────────────────────────
# Token from @BotFather. Required for the bot, for /premium and for
# the FREE/PREMIUM command-tier manager (/commands).
# Without it the web panel still boots; only the bot stays offline.
BOT_TOKEN=

# Numeric Telegram user id of the panel owner (from @userinfobot).
# This is the FIRST owner; further owners live in Database/akses.json.
OWNER_ID=

# ── HTTP server ──────────────────────────────────────────────
# Railway / Katabump / Pterodactyl usually inject PORT automatically.
# The app falls back to 2024 when this is unset.
PORT=2024

# ── reverse proxy ────────────────────────────────────────────
# Set to 1 ONLY when the app sits behind a trusted proxy
# (Railway, Nginx, Cloudflare, Pterodactyl wings).
# Leaving it unset keeps X-Forwarded-For untrusted, which is safer
# on a direct-to-node deployment.
TRUST_PROXY=

# Optional: allow one extra origin to call the API with cookies.
# Leave unset for same-origin only. Example: https://panel.example.com
PANEL_ORIGIN=

# ── banners (optional) ───────────────────────────────────────
# BANNER_TELEGRAM is the photo used by the bot's /start command.
BANNER_TELEGRAM=
# BANNER_DASHBOARD and BANNER_LOGIN are reserved: the web pages ship their
# own local Assets/ images, so these two are currently not read anywhere.
BANNER_DASHBOARD=
BANNER_LOGIN=

# ── demo account (optional, dev only) ────────────────────────
# Used only by `npm run demo`. The account is NEVER created at boot,
# so these can stay empty on a real deployment. If you do seed a demo
# account on a public host, set a strong DEMO_PASSWORD here first.
DEMO_USERNAME=demo
DEMO_PASSWORD=
DEMO_EMAIL=